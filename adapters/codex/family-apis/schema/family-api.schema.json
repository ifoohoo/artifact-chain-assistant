{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://artifact-chain.dev/schemas/family-api.schema.json",
  "title": "Skill Family API",
  "description": "由 artifact-chain-assistant 统一维护的标准技能族 API（Skill Family API）接口定义契约。",
  "type": "object",
  "required": ["schemaVersion", "api", "services"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "api": {
      "type": "object",
      "required": ["id", "major", "revisionDigest", "displayName", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^artifact\\.[a-z][a-z0-9-]*-family$",
          "description": "位于 artifact.* 命名空间下的规范技能族 API 标识。"
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "description": "标识接口兼容世代的主版本号。"
        },
        "revisionDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "剔除本字段后对规范化 API 定义内容计算得到的不可变 SHA-256 摘要。"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifactTypes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "本技能族负责处理的制品类型标识列表。"
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/service"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/capability"
      },
      "description": "可选公开能力声明列表（不包含实现侧运行状态）。"
    },
    "dataTransferObjects": {
      "type": "array",
      "items": { "$ref": "#/definitions/dataTransferObject" },
      "description": "Family API 拥有的结构化中间或正式 DTO 声明；schema 仍由 family 提供，接口编译器只校验声明形状和服务引用。"
    },
    "qualificationKinds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
      "uniqueItems": true,
      "description": "该 Family API 区分的资格种类名称；只声明种类，不把资格证据或成熟度写入接口。"
    }
  },
  "definitions": {
    "service": {
      "type": "object",
      "required": ["id", "required", "kind", "intents"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^artifact\\.[a-z][a-z0-9-]+\\.[a-z][a-z0-9-]+$",
          "description": "规范服务标识，格式为 artifact.<family>.<intent>。"
        },
        "required": {
          "type": "boolean",
          "description": "实现该技能族 API 时是否必须提供此服务。"
        },
        "kind": {
          "type": "string",
          "enum": ["workflow", "operation"],
          "description": "服务执行形态：workflow 表示有状态多步工作流，operation 表示无状态单步操作。"
        },
        "intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["default", "help", "author", "review", "repair", "route", "audit", "generate", "batch"]
          },
          "uniqueItems": true
        },
        "accepts": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/definitions/protocolRef" }
            ]
          },
          "description": "输入契约引用或自然语言输入要求说明。"
        },
        "produces": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/definitions/protocolRef" }
            ]
          },
          "description": "输出契约引用或自然语言产出物说明。"
        },
        "sideEffectCeiling": {
          "type": "string",
          "enum": ["none", "read-only", "write-authorized-artifacts", "write-review-result", "write-project-artifacts"],
          "description": "该服务允许产生的最高副作用边界级别。"
        },
        "mixSafe": {
          "type": "boolean",
          "default": false,
          "description": "该服务是否允许与同一技能族下的其他服务绑定到不同的实现提供方。"
        },
        "discoverable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "type": "boolean",
              "description": "是否作为该技能族的默认发现入口。"
            },
            "help": {
              "type": "boolean",
              "description": "是否作为该技能族的帮助与能力概览入口。"
            }
          }
        },
        "modes": {
          "$ref": "#/definitions/serviceModes"
        }
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "serviceModes": {
      "type": "object",
      "required": ["supported", "default"],
      "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "default": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "dataTransferObject": {
      "type": "object",
      "required": ["id", "schemaId", "schema", "version", "digestRule", "services"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "schemaId": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "pattern": "^[^/\\\\~].*\\.json$" },
        "version": { "type": "string", "minLength": 1 },
        "digestRule": { "type": "string", "minLength": 1 },
        "artifactBinding": { "type": "string", "minLength": 1 },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "position"],
            "additionalProperties": false,
            "properties": {
              "service": { "type": "string", "pattern": "^artifact\\.[a-z][a-z0-9-]+\\.[a-z][a-z0-9-]+$" },
              "position": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "contractRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*@[0-9]+$",
      "description": "制品契约主版本身份引用（例如 artifact.e2e-test@1）。"
    },
    "protocolRef": {
      "type": "object",
      "required": ["protocol", "version"],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1,
          "description": "尚无正式制品契约时引用的协议名称。"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "所引用协议的版本号。"
        },
        "input": {
          "type": "string",
          "description": "说明该协议所接收或产出的载荷用途。"
        }
      }
    }
  }
}
